<% content_for :title, "New chart" %>

<p><%= link_to "← #{@cat_import.name}", @cat_import %></p>

<h1>Create a chart</h1>
<p class="muted">From the <%= pluralize @cat_import.cats.count, "cat" %> and <%= pluralize @cat_import.breeds.count, "breed" %> of <%= @cat_import.name %>.</p>

<section class="card">
  <%= form_with model: [ @cat_import, @chart ] do |form| %>
    <%= form.label :prompt, "What should the chart show?" %>
    <%= form.text_area :prompt, rows: 6, required: true, autofocus: true,
          placeholder: "e.g. A bar chart of the number of cats per breed, largest first" %>
    <% if @chart.errors.any? %>
      <p class="error"><%= @chart.errors.full_messages.to_sentence %></p>
    <% end %>
    <p class="muted">An AI agent analyses the imported cats and breeds and draws a chart for you. If your request is unclear, it asks you.</p>
    <%= form.submit "Create chart", class: "button" %>
  <% end %>
</section>
