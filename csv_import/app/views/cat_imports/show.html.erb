<% content_for :title, @cat_import.name %>

<%= render "cat_imports/header", cat_import: @cat_import, tab: "cats" %>

<%= turbo_stream_from @cat_import %>
<%= render "agent_runs/status", run: @cat_import %>
<%= render "agent_runs/question", run: @cat_import %>
<%= render "agent_runs/activity", run: @cat_import %>
<%= render "cat_imports/cats", cat_import: @cat_import %>

<% analyses = { "Reports" => @cat_import.reports, "Charts" => @cat_import.charts } %>
<% analyses.each do |heading, records| %>
  <% records = records.order(created_at: :desc) %>
  <% next if records.none? %>

  <section class="card">
    <h2><%= heading %></h2>
    <table class="table">
      <thead>
        <tr><th><%= heading.singularize %></th><th>Request</th><th>Status</th><th>Created</th></tr>
      </thead>
      <tbody>
        <% records.each do |record| %>
          <tr>
            <td><%= link_to record.name, record %></td>
            <td class="muted"><%= truncate record.prompt, length: 80 %></td>
            <td><%= status_badge(record) %></td>
            <td class="muted"><%= time_ago_in_words(record.created_at) %> ago</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>
